# Separate from the native .env; the launchers copy this only when absent.
QUIBAR_PORT=8000
QUIBAR_WEB_PORT=3000
QUIBAR_MODEL=qwen3:14b-q4_K_M
QUIBAR_MODEL_TIMEOUT=6
# docker (default), native (host Ollama), or remote (an existing private server).
QUIBAR_OLLAMA_MODE=docker
# With remote, set OLLAMA_URL=http://TAILSCALE_IP:11434; models are never pulled.
