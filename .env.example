# Vite development server (production is served by FastAPI)
QUIBAR_WEB_PORT=3000
QUIBAR_API_HOST=127.0.0.1
QUIBAR_API_PORT=8000

# Local inference. The default production deadline falls back to basic mode after 6s.
OLLAMA_URL=http://127.0.0.1:11434
QUIBAR_MODEL=qwen3:14b-q4_K_M
QUIBAR_MODEL_TIMEOUT=6
QUIBAR_MODEL_KEEP_ALIVE=-1

# Optional absolute paths (defaults point inside the repository)
# QUIBAR_DB_PATH=/var/lib/quibar/quibar.sqlite3
# QUIBAR_MEDIA_DIR=/var/lib/quibar/media
# QUIBAR_TILES_PATH=/var/lib/quibar/map.mbtiles
# QUIBAR_DIST_DIR=/opt/quibar/dist
# Administrative access: loopback or authorized Tailscale peers, never public LAN.
QUIBAR_ADMIN_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10
